{
  "name": "viter-portofolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The vitermoldy GitHub profile in 3D: the pixel art as voxels, a year of contributions as a skyline, every project card as a relief.",
  "scripts": {
    "dev": "vite",
    "sync": "node scripts/sync-profile.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
